[debug] [2026-09-18T10:42:47.987Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/durga-sarees/rulesets {"name":"projects/durga-sarees/rulesets/27882b61-8b87-46bd-9a21-7603280488d8","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // 1. Fetch the user's role from the centralized Settings/Roles document\n    function getRole() {\n      return (request.auth != null && request.auth.token.phone_number != null && exists(/databases/$(database)/documents/Settings/Roles))\n             ? get(/databases/$(database)/documents/Settings/Roles).data.get(request.auth.token.phone_number, null)\n             : null;\n    }\n    \n    // 2. Role Checkers\n    function isSuperAdmin() {\n      return request.auth != null && (request.auth.token.phone_number == '+919425032549' || request.auth.token.phone_number == '+919302632549');\n    }\n    function isAdmin() { return request.auth != null && (isSuperAdmin() || getRole() == 'admin'); }\n    function isInventory() { return request.auth != null && getRole() == 'inventory'; }\n    function isPacking() { return request.auth != null && getRole() == 'packing'; }\n\n    // ==========================================\n    // SETTINGS COLLECTION\n    // ==========================================\n    match /Settings/StickerTemplate {\n      allow read, write: if true;\n    }\n    match /settings/stickerLayout {\n      allow read, write: if true;\n    }\n    match /settings/{document=**} {\n      allow read: if request.auth != null;\n      allow write: if isAdmin();\n    }\n    match /Settings/{document=**} {\n      allow read: if request.auth != null;\n      allow write: if isAdmin();\n    }\n    match /Settings/{document=**} {\n      allow read: if request.auth != null;\n      allow write: if isAdmin();\n    }\n\n    // ==========================================\n    // PRODUCTS COLLECTION\n    // ==========================================\n    match /Products/{productId} {\n      // Anyone can view the catalog\n      allow read: if true;\n      \n      // Admins can do anything\n      allow write: if isAdmin();\n      \n      // Inventory can ONLY update stock-related fields\n      allow update: if isInventory() && \n                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                      'stock', \n                      'updateTime', \n                      'coverDesignId'\n                    ]);\n                    \n      // Packing can ONLY update packing details\n      allow update: if isPacking() && \n                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                      'packing'\n                    ]);\n    }\n\n    // ==========================================\n    // USERS COLLECTION\n    // ==========================================\n    match /Users/{userId} {\n      // Admins can view/edit all users\n      allow read, write: if isAdmin();\n      \n      // A user can create their own profile, or read/update their own profile\n      allow create: if request.auth != null && request.resource.data.phone == request.auth.token.phone_number;\n      allow read, update: if request.auth != null && resource.data.phone == request.auth.token.phone_number;\n    }\n\n    // ==========================================\n    // ORDERS / EVERYTHING ELSE\n    // ==========================================\n    match /LiveSessions/{sessionId} {\n      allow read: if isAdmin();\n      allow write: if true;\n    }\n\n    match /{document=**} {\n      // Deny all access by default unless explicitly allowed above, \n      // EXCEPT Admins who have god-mode over the entire database\n      allow read, write: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-18T10:42:47.724543Z","metadata":{"services":["cloud.firestore"]}}
