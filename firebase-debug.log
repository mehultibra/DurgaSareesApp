[debug] [2026-09-14T10:52:32.968Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/durga-sarees/rulesets {"name":"projects/durga-sarees/rulesets/5394e996-f4dc-4cde-9151-ef173745ed03","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // 1. Fetch the user's role from the centralized Settings/Roles document\n    function getRole() {\n      return (request.auth != null && request.auth.token.phone_number != null && exists(/databases/$(database)/documents/Settings/Roles))\n             ? get(/databases/$(database)/documents/Settings/Roles).data.get(request.auth.token.phone_number, null)\n             : null;\n    }\n    \n    // 2. Role Checkers\n    function isAdmin() { return request.auth != null && getRole() == 'admin'; }\n    function isInventory() { return request.auth != null && getRole() == 'inventory'; }\n    function isPacking() { return request.auth != null && getRole() == 'packing'; }\n\n    // ==========================================\n    // PRODUCTS COLLECTION\n    // ==========================================\n    match /Products/{productId} {\n      // Anyone can view the catalog\n      allow read: if true;\n      \n      // Admins can do anything\n      allow write: if isAdmin();\n      \n      // Inventory can ONLY update stock-related fields\n      allow update: if isInventory() && \n                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                      'stock', \n                      'updateTime', \n                      'coverDesignId'\n                    ]);\n                    \n      // Packing can ONLY update packing details\n      allow update: if isPacking() && \n                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                      'packing'\n                    ]);\n    }\n\n    // ==========================================\n    // USERS COLLECTION\n    // ==========================================\n    match /Users/{userId} {\n      // Admins can view/edit all users\n      allow read, write: if isAdmin();\n      \n      // A user can create their own profile, or read/update their own profile\n      allow create: if request.auth != null && request.resource.data.get('phone', '') == request.auth.token.get('phone_number', 'UNMATCHABLE');\n      allow read, update: if request.auth != null && resource.data.get('phone', '') == request.auth.token.get('phone_number', 'UNMATCHABLE');\n    }\n\n    // ==========================================\n    // SETTINGS / ORDERS / EVERYTHING ELSE\n    // ==========================================\n    match /LiveSessions/{sessionId} {\n      allow read: if isAdmin();\n      allow write: if true;\n    }\n\n    match /{document=**} {\n      // Deny all access by default unless explicitly allowed above, \n      // EXCEPT Admins who have god-mode over the entire database\n      allow read, write: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-14T10:52:30.925103Z","metadata":{"services":["cloud.firestore"]}}
