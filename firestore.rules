rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Fetch the user's role from the centralized Settings/Roles document
    function getRole() {
      return (request.auth != null && request.auth.token.phone_number != null && exists(/databases/$(database)/documents/Settings/Roles))
             ? get(/databases/$(database)/documents/Settings/Roles).data.get(request.auth.token.phone_number, null)
             : null;
    }
    
    // 2. Role Checkers
    function isSuperAdmin() {
      return request.auth != null && (request.auth.token.phone_number == '+919425032549' || request.auth.token.phone_number == '+919302632549');
    }
    function isAdmin() { return request.auth != null && (isSuperAdmin() || getRole() == 'admin'); }
    function isInventory() { return request.auth != null && getRole() == 'inventory'; }
    function isPacking() { return request.auth != null && getRole() == 'packing'; }

    // ==========================================
    // SETTINGS COLLECTION
    // ==========================================
    match /Settings/StickerTemplate {
      allow read, write: if request.auth != null;
    }
    match /settings/stickerLayout {
      allow read, write: if request.auth != null;
    }
    match /settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /Settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /Settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ==========================================
    // PRODUCTS COLLECTION
    // ==========================================
    match /Products/{productId} {
      // Anyone can view the catalog
      allow read: if true;
      
      // Admins can do anything
      allow write: if isAdmin();
      
      // Inventory can ONLY update stock-related fields
      allow update: if isInventory() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'stock', 
                      'updateTime', 
                      'coverDesignId'
                    ]);
                    
      // Packing can ONLY update packing details
      allow update: if isPacking() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'packing'
                    ]);
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /Users/{userId} {
      // Admins can view/edit all users
      allow read, write: if isAdmin();
      
      // A user can create their own profile, or read/update their own profile
      allow create: if request.auth != null && request.resource.data.phone == request.auth.token.phone_number;
      allow read, update: if request.auth != null && resource.data.phone == request.auth.token.phone_number;
    }

    // ==========================================
    // ORDERS / EVERYTHING ELSE
    // ==========================================
    match /LiveSessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if true;
    }

    match /{document=**} {
      // Deny all access by default unless explicitly allowed above, 
      // EXCEPT Admins who have god-mode over the entire database
      allow read, write: if isAdmin();
    }
  }
}
