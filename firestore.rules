rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Fetch the user's role from the centralized Settings/Roles document
    function getRole() {
      return (request.auth != null && request.auth.token.phone_number != null && exists(/databases/$(database)/documents/Settings/Roles))
             ? get(/databases/$(database)/documents/Settings/Roles).data.get(request.auth.token.phone_number, null)
             : null;
    }
    
    function getUserDoc() {
      return (request.auth != null && request.auth.token.phone_number != null && exists(/databases/$(database)/documents/Users/$(request.auth.token.phone_number)))
             ? get(/databases/$(database)/documents/Users/$(request.auth.token.phone_number)).data
             : null;
    }

    // 2. Role Checkers
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.phone_number == '+919998232380' ||
        request.auth.token.phone_number == '+919712277640' ||
        request.auth.token.phone_number == '+919328193525' ||
        (getUserDoc() != null && getUserDoc().get('isAdmin', false) == true)
      );
    }
    function isAdmin() {
      return request.auth != null && (isSuperAdmin() || getRole() == 'admin');
    }
    function isStaffOrAdmin() {
      return request.auth != null && (
        isAdmin() ||
        getRole() == 'staff' ||
        (getUserDoc() != null && getUserDoc().get('isStaff', false) == true)
      );
    }
    function isApprovedUser() {
      return isStaffOrAdmin() || (
        getUserDoc() != null &&
        getUserDoc().get('isApproved', false) == true &&
        getUserDoc().get('approvalStatus', 'pending') == 'approved'
      );
    }
    function isInventory() { return request.auth != null && getRole() == 'inventory'; }
    function isPacking() { return request.auth != null && getRole() == 'packing'; }

    // ==========================================
    // SETTINGS & CONFIG COLLECTIONS
    // ==========================================
    match /Settings/StickerTemplate {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/stickerLayout {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /Settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /AppConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // PRODUCTS COLLECTION
    // ==========================================
    match /Products/{productId} {
      // Anyone can view the catalog
      allow read: if true;
      
      // Admins can do anything
      allow write: if isAdmin();
      
      // Inventory can ONLY update stock-related fields
      allow update: if isInventory() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'stock', 
                      'updateTime', 
                      'coverDesignId'
                    ]);
                    
      // Packing can ONLY update packing details
      allow update: if isPacking() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'packing'
                    ]);
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /Users/{userId} {
      // Admins and Staff can view/edit users for CRM, party linking & phone lookup
      allow read, write: if isStaffOrAdmin();
      
      // A user can create basic profile + pending auto-link fields ONLY (never pre-approved or admin/staff)
      allow create: if request.auth != null
                    && (request.resource.data.phone == request.auth.token.phone_number || userId == request.auth.token.phone_number)
                    && !request.resource.data.keys().hasAny(['isAdmin', 'isStaff', 'approvedByAdmin', 'approvedAt', 'pricingTier', 'linkedAccountDocId'])
                    && request.resource.data.get('isApproved', false) == false
                    && request.resource.data.get('approvalStatus', 'pending') == 'pending'
                    && request.resource.data.get('role', 'customer') in ['customer', 'agent'];
      allow read: if request.auth != null && (resource.data.phone == request.auth.token.phone_number || userId == request.auth.token.phone_number);
      allow update: if request.auth != null
                    && (resource.data.phone == request.auth.token.phone_number || userId == request.auth.token.phone_number)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isStaff', 'isApproved', 'approvalStatus', 'approvedByAdmin', 'approvedAt', 'linkedAccount', 'linkedAccountDocId', 'linkedAccountName', 'role', 'pricingTier']);
    }

    // ==========================================
    // PARTY LINKS (Permanent Cloud Linking & Party Data)
    // ==========================================
    match /PartyLinks/{linkId} {
      allow read, write: if isStaffOrAdmin();
    }

    // ==========================================
    // CRM COLLECTIONS (Live Multi-Staff CRM)
    // ==========================================
    match /PartyCRM/{partyCode} {
      allow read, write: if isStaffOrAdmin();
    }
    match /CRMLogs/{logId} {
      allow read, write: if isStaffOrAdmin();
    }

    // ==========================================
    // ERP CLOUD COLLECTIONS (Accounting Brain)
    // ==========================================
    function getPhone10() {
      return (request.auth != null && request.auth.token.phone_number != null && request.auth.token.phone_number.size() >= 10)
        ? request.auth.token.phone_number[request.auth.token.phone_number.size() - 10 : request.auth.token.phone_number.size()]
        : '';
    }

    function isAllowedPartyReport(docId) {
      return isStaffOrAdmin() || (
        isApprovedUser() && (
          (getUserDoc() != null && getUserDoc().get('linkedAccountDocId', '') == docId) ||
          (
            getPhone10().size() == 10
            && exists(/databases/$(database)/documents/PhoneDirectory/$(getPhone10()))
            && docId in get(/databases/$(database)/documents/PhoneDirectory/$(getPhone10())).data.get('allowedDocIds', [])
          )
        )
      );
    }

    match /AccountingMeta/{docId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }
    match /AccountingCustomers/{docId} {
      allow get: if isAllowedPartyReport(docId);
      allow list, write: if isStaffOrAdmin();
    }
    match /AccountingReports/{docId} {
      allow get: if isAllowedPartyReport(docId);
      allow list: if isStaffOrAdmin();
      allow write: if isAdmin();
    }
    match /PhoneDirectory/{phoneId} {
      allow get: if isStaffOrAdmin() || (request.auth != null && getPhone10() == phoneId);
      allow list, write: if isStaffOrAdmin();
    }
    match /AgentDirectories/{phoneId} {
      allow get: if isStaffOrAdmin() || (isApprovedUser() && getPhone10() == phoneId);
      allow list, write: if isStaffOrAdmin();
    }

    // ==========================================
    // ORDERS / EVERYTHING ELSE
    // ==========================================
    match /LiveSessions/{sessionId} {
      allow read: if isStaffOrAdmin()
                  || (request.auth != null && (sessionId == request.auth.token.phone_number || '+91' + sessionId == request.auth.token.phone_number));
      allow get: if sessionId.matches('^guest_.*');
      // Allow presence updates from both Web and native Capacitor APK WebViews (which use native Auth rather than Web SDK Auth),
      // while blocking privilege fields and restricting reads strictly to Staff/Admin or the matching phone user.
      allow create, update: if isStaffOrAdmin()
                            || (
                              !('isAdmin' in request.resource.data && request.resource.data.isAdmin == true)
                              && !('isStaff' in request.resource.data && request.resource.data.isStaff == true)
                            );
      allow delete: if isStaffOrAdmin();
    }

    match /{document=**} {
      // Deny all access by default unless explicitly allowed above, 
      // EXCEPT Admins who have god-mode over the entire database
      allow read, write: if isAdmin();
    }
  }
}
